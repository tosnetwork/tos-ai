{
  "version": 1,
  "backend": {
    "type": "containerd",
    "socketPath": "/run/tos-ai/containerd.sock",
    "namespace": "tos-ai-gpu",
    "snapshotter": "overlayfs",
    "runtime": "io.containerd.runc.v2",
    "fifoDir": "/run/tos-ai/containerd-gpu-fifos",
    "maxActive": 1,
    "gpuDevices": [
      {
        "alias": "gpu-a",
        "cdiDevice": "nvidia.com/gpu=0"
      }
    ]
  },
  "capability": {
    "serviceId": "tos.ai.isolated-gpu",
    "operation": "generate",
    "model": "operator-approved-model",
    "modelDigest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "runtime": "containerd",
    "runtimeRevision": "containerd-2.x-nvidia-cdi-reviewed",
    "maxInputBytes": 1048576,
    "maxOutputBytes": 1048576,
    "acceptedPriorities": [4, 5],
    "admission": {
      "ramBytes": 8589934592,
      "vramBytes": 12884901888,
      "kvCacheBytes": 4294967296,
      "contextTokens": 8192,
      "batchSize": 1,
      "executionMillis": 120000
    }
  },
  "container": {
    "imageReference": "registry.example/tos/infer@sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "imageDigest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "entrypoint": ["/opt/tos/infer", "--stdio"],
    "environment": {
      "MODEL_PATH": "/models/operator-approved-model"
    },
    "userId": 65532,
    "groupId": 65532,
    "network": "none",
    "allowGpu": true,
    "cpuMillis": 60000,
    "diskBytes": 1073741824,
    "pids": 64,
    "gpuDevices": 1
  }
}
